VITE_API_BASE_URL=http://localhost:5000
VITE_APP_BACKEND_ENDPOINT=http://localhost:5173
VITE_FILE_BASE_PATH=assets/music/
VITE_ENV=development
VITE_STRIPE_PUBLISHABLE_KEY=

# Server-side only (Netlify functions). Never prefix secrets with VITE_,
# because Vite inlines every VITE_* variable into the browser bundle.
STRIPE_SECRET_KEY=

# EmailJS (contact form). These are read in the browser, so they need the VITE_ prefix.
VITE_JS_PUBLIC_KEY=
VITE_JS_TEMPLATE_ID=
VITE_JS_SERVICE_ID=

DROPBOX_ACCESS_TOKEN=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REFRESH_TOKEN=

SUPABASE_URL=
SUPABASE_KEY=